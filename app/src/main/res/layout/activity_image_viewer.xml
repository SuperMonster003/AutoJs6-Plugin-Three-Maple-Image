<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <io.github.supermonster003.autojs6.plugin.three.maple.image.ZoomableImageView
        android:id="@+id/image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/image_content_description" />

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/loading_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center" />

    <TextView
        android:id="@+id/error_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginHorizontal="32dp"
        android:background="@color/error_background"
        android:gravity="center"
        android:padding="16dp"
        android:text="@string/error_cannot_read_image"
        android:textColor="@color/error_text"
        android:visibility="gone" />

    <TextView
        android:id="@+id/zoom_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:background="@drawable/bg_zoom_indicator"
        android:elevation="4dp"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:minWidth="56dp"
        android:textAppearance="@style/TextAppearance.MaterialComponents.Body1"
        android:textColor="@color/zoom_indicator_text"
        android:textStyle="bold"
        android:visibility="gone"
        tools:text="2.5x"
        tools:visibility="visible" />

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:layout_gravity="top"
        android:background="@color/toolbar_overlay_background"
        android:elevation="0dp"
        android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar"
        app:navigationContentDescription="@string/action_back"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:popupTheme="@style/ThemeOverlay.MaterialComponents.Light"
        app:subtitleTextColor="@color/toolbar_text"
        app:titleTextColor="@color/toolbar_text"
        tools:subtitle="3 / 12"
        tools:title="photo.jpg" />

    <LinearLayout
        android:id="@+id/bottom_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/animation_toggle"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="end"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:contentDescription="@string/action_pause_animation"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:visibility="gone"
            app:cornerRadius="24dp"
            app:icon="@drawable/ic_pause"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="24dp"
            tools:visibility="visible" />

        <LinearLayout
            android:id="@+id/bottom_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/overlay_surface"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/metadata"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center_horizontal"
                android:maxLines="1"
                android:paddingHorizontal="4dp"
                android:text="@string/metadata_loading"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Body2" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/image_details_toggle"
                    style="@style/Widget.App.BottomActionButton"
                    android:contentDescription="@string/action_show_image_details"
                    android:text="@string/label_details"
                    android:visibility="gone"
                    app:icon="@drawable/ic_info_outline"
                    tools:visibility="visible" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/rotate_clockwise"
                    style="@style/Widget.App.BottomActionButton"
                    android:contentDescription="@string/action_rotate_clockwise"
                    android:text="@string/label_rotate"
                    app:icon="@drawable/ic_rotate_right" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/share"
                    style="@style/Widget.App.BottomActionButton"
                    android:text="@string/action_share"
                    app:icon="@drawable/ic_share" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/open_external"
                    style="@style/Widget.App.BottomActionButton"
                    android:contentDescription="@string/action_open_external"
                    android:text="@string/label_open_with"
                    app:icon="@drawable/ic_open_in_new" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/details_sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_details_sheet"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingBottom="16dp"
        android:visibility="gone"
        app:behavior_hideable="true"
        app:behavior_peekHeight="0dp"
        app:behavior_skipCollapsed="true"
        app:gestureInsetBottomIgnored="true"
        app:layout_behavior="@string/bottom_sheet_behavior"
        tools:visibility="visible">

        <com.google.android.material.bottomsheet.BottomSheetDragHandleView
            style="@style/Widget.Material3.BottomSheet.DragHandle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:tint="?attr/colorControlNormal" />

        <TextView
            android:id="@+id/details_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="middle"
            android:maxLines="2"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Subtitle1"
            android:textStyle="bold"
            tools:text="photo.jpg" />

        <TextView
            android:id="@+id/details_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Body2"
            tools:text="image/jpeg | 1.2 MB | 4000 x 3000 px" />

        <TextView
            android:id="@+id/exif_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="2dp"
            android:paddingTop="12dp"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Body2"
            tools:text="Captured: 2026-08-31 14:05:09\nDevice: Pixel" />
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
