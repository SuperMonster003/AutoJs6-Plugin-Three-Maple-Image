<?xml version="1.0" encoding="utf-8"?>
<!-- Debug-only additions for the ROADMAP 5.1 image-loading spike. Release builds never merge this file,
     so the release manifest keeps declaring no storage permission (ROADMAP R2). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <application>
        <!-- The empty host of the Compose tests that set their own content, in place of the exported
             androidx.activity.ComponentActivity of ui-test-manifest. Not exported; same theme as that activity. -->
        <activity android:name=".ComposeTestActivity" android:exported="false" android:theme="@android:style/Theme.Material.Light.NoActionBar" />
        <activity android:name=".debug.ComposeSpikeActivity" android:exported="true" android:theme="@style/Theme.Standalone" tools:ignore="ExportedActivity" />
        <activity android:name=".debug.ComposeShowcaseActivity" android:exported="true" android:theme="@style/Theme.Standalone" tools:ignore="ExportedActivity" />
    </application>
</manifest>
